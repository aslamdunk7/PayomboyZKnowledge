-- 📡 ฟังก์ชั่นดึง HWID
local function getMachineHWID()
    if gethwid then return gethwid() end
    local success, clientId = pcall(function() return RbxAnalytics:GetClientId() end)
    if success and clientId then return clientId end
    return "UNKNOWN_HWID_" .. tostring(Players.LocalPlayer.UserId)
end

