loginBtn.MouseButton1Click:Connect(function()
    local inputKey = keyInput.Text
    local currentTime = os.time()
    
    -- 1. ตรวจสอบคีย์ทดลอง (2 ชั่วโมง)
    if inputKey == trialKey then
        local myHWID = getMachineHWID()
        
        if isfile and isfile(trialFileName) then
            local data = readfile(trialFileName)
            local savedHWID, endTrialStr, nextPlayStr = string.match(data, "(.-)|(.-)|(.+)")
            local endTrialTime = tonumber(endTrialStr) or 0
            local nextPlayTime = tonumber(nextPlayStr) or 0
            
            if myHWID == savedHWID then
                -- ถ้ารอจนเลย 24 ชั่วโมงแล้ว -> รีเซ็ตให้เล่นใหม่ได้
                if currentTime >= nextPlayTime then
                    local newEndTrial = currentTime + trialDuration
                    local newNextPlay = currentTime + cooldownDuration
                    writefile(trialFileName, myHWID .. "|" .. tostring(newEndTrial) .. "|" .. tostring(newNextPlay))
                    
                    statusText.TextColor3 = COLORS.primary
                    statusText.Text = "✅ รีเซ็ตเวลาให้ใหม่ เริ่มต้นทดลองใช้ 2 ชั่วโมง!"
                    task.wait(1)
                    gui:Destroy()
                    task.spawn(function()
                        task.wait(trialDuration)
                        TriggerCustomKick(newNextPlay)
                    end)
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/aslamdunk7/PayomboyZKnowledge/refs/heads/main/AIsrc.lua"))()
                    return
                end
                
                -- ถ้ายังไม่ถึงเวลารีเซ็ต แต่หมด 2 ชั่วโมงไปแล้ว
                if currentTime >= endTrialTime then
                    statusText.TextColor3 = COLORS.danger
                    statusText.Text = "❌ หมดเวลา 2 ชั่วโมงแล้วจ้า! พรุ่งนี้ค่อยมาใหม่"
                    shakeUI()
                    task.wait(1.5)
                    TriggerCustomKick(nextPlayTime)
                    return
                else
                    -- ยังอยู่ในช่วง 2 ชั่วโมง
                    local timeLeft = math.floor((endTrialTime - currentTime) / 60)
                    local timeSeconds = endTrialTime - currentTime
                    
                    statusText.TextColor3 = COLORS.primary
                    statusText.Text = "✅ ทดลองใช้ต่อ (เหลือ " .. timeLeft .. " นาที)"
                    task.wait(1)
                    gui:Destroy()
                    task.spawn(function()
                        task.wait(timeSeconds)
                        TriggerCustomKick(nextPlayTime)
                    end)
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/aslamdunk7/PayomboyZKnowledge/refs/heads/main/AIsrc.lua"))()
                    return
                end
            else
                statusText.TextColor3 = COLORS.danger
                statusText.Text = "❌ คีย์ทดลองนี้ถูกใช้ด้วยเครื่องอื่นไปแล้ว!"
                shakeUI()
                return
            end
        else
            -- เข้าใช้งานครั้งแรกด้วยคีย์ทดลอง
            if writefile then
                local endTrialTime = currentTime + trialDuration
                local nextPlayTime = currentTime + cooldownDuration
                writefile(trialFileName, myHWID .. "|" .. tostring(endTrialTime) .. "|" .. tostring(nextPlayTime))
                
                statusText.TextColor3 = COLORS.primary
                statusText.Text = "✅ เริ่มต้นทดลองใช้งาน 2 ชั่วโมง!"
                task.wait(1)
                gui:Destroy()
                task.spawn(function()
                    task.wait(trialDuration)
                    TriggerCustomKick(nextPlayTime)
                end)
                loadstring(game:HttpGet("https://raw.githubusercontent.com/aslamdunk7/PayomboyZKnowledge/refs/heads/main/AIsrc.lua"))()
                return
            else
                statusText.TextColor3 = COLORS.danger
                statusText.Text = "❌ Executor ของคุณไม่รองรับระบบบันทึกเวลา"
                shakeUI()
                return
            end
        end
    end
    
    -- 2. เช็คคีย์ปกติ 50 คีย์ (ไม่มีหมดอายุ)
    local isValid = false
    for _, key in ipairs(validKeys) do
        if inputKey == key then
            isValid = true
            break
        end
    end
    
    if isValid then
        statusText.TextColor3 = COLORS.primary
        statusText.Text = "✅ คีย์ถูกต้อง กำลังโหลดฮับ..."
        task.wait(1)
        gui:Destroy()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/aslamdunk7/PayomboyZKnowledge/refs/heads/main/AIsrc.lua"))()
    else
        statusText.TextColor3 = COLORS.danger
        statusText.Text = "ควยอย่าเดารหัส"
        shakeUI()
    end
end)
