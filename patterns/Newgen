local function clearEggESP()
    pcall(function()
        if espTags then
            for uid, tagData in pairs(espTags) do
                pcall(function()
                    if tagData.gui then tagData.gui:Destroy() end
                    if tagData.refPart then tagData.refPart:Destroy() end
                end)
            end
            table.clear(espTags)
        end
        local p = getSafeGuiParent()
        local folder = p:FindFirstChild("EggESP_Container")
        if folder then folder:Destroy() end
        ESP_FOLDER = nil
    end)
end

local function updateEggESP()
    if not Cfg_EggESP then
        if next(espTags or {}) then clearEggESP() end
        return
    end

    local folder = getESPFolder()
    local liveUids = {}
