local espTags = {}
local Cfg_EggESP = false

local function clearEggESP()
    pcall(function()
        if espTags then
            for uid, tagData in pairs(espTags) do
                pcall(function()
                    if tagData.gui then tagData.gui:Destroy() end
                    if tagData.refPart then tagData.refPart:Destroy() end
                end)
            end
            table.clear(espTags)
        end
        local p = getSafeGuiParent()
        local folder = p:FindFirstChild("EggESP_Container")
        if folder then folder:Destroy() end
        ESP_FOLDER = nil
    end)
end

local function updateEggESP()
    if not Cfg_EggESP then
        if next(espTags or {}) then clearEggESP() end
        return
    end

    local folder = getESPFolder()
    local liveUids = {}
    local char = E and E.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
    local myPos = root and root.Position or Vector3.zero

    local allEggs = nil
    if r and r.ReadFieldEggs then
        local ok, rRes = pcall(r.ReadFieldEggs)
        if ok and type(rRes) == "table" then
            allEggs = rRes.Records or rRes
        end
    end
    if not allEggs or #allEggs == 0 then
        local rf = h:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot", true) or h:FindFirstChild("AskFieldEggSnapshot", true) or h:FindFirstChild("Eggs: RequestAreaEggSnapshot", true)
        if rf and rf:IsA("RemoteFunction") then
            pcall(function()
                local rSnap = rf:InvokeServer()
                if type(rSnap) == "table" and (rSnap.Records and #rSnap.Records > 0) then
                    allEggs = rSnap.Records
                end
            end)
        end
    end

    if allEggs and type(allEggs) == "table" then
        for _, rec in pairs(allEggs) do
            if type(rec) == "table" then
