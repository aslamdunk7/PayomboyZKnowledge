function Nav.secondsUntilDawn()
    if _CycleModule and type(_CycleModule.SecondsUntilReset) == "function" then
        local ok, sec = pcall(_CycleModule.SecondsUntilReset, os.time())
        if ok and tonumber(sec) then return tonumber(sec) end
    end
    local clock = Lighting and Lighting.ClockTime or 12
    if clock >= 6 and clock <= 18 then return 999 end
    local remainingHours = (clock < 6) and (6 - clock) or (24 - clock + 6)
    return remainingHours * 4
end

