local function petItems(fresh, yieldEvery)
    local now = os.clock()
    if not fresh and petCache and now - petCacheAt < 2 then return petCache end

    local data = saveData()
    local inv  = data.Inventory or {}
    local equipped = {}
    for _, uid in ipairs(data.EquippedAssets or {}) do equipped[uid] = true end

    local list = {}
    local seen = 0
    for uid, raw in pairs(inv) do
        seen = seen + 1
        if yieldEvery and seen % yieldEvery == 0 then task.wait() end
        local item = raw
        if AssetSer and type(raw) ~= "table" then
            local ok, d = pcall(AssetSer.Deserialize, raw)
            if ok and type(d) == "table" then item = d end
        end

        if type(item) == "table" and (item.Category or item.AssetCategory) then
            local cat = item.Category or item.AssetCategory
            local rate = 0
            if AssetGen and type(AssetGen.GetRateWithoutBoosts) == "function" then
                local okr, r = pcall(AssetGen.GetRateWithoutBoosts, item)
                if okr and tonumber(r) then rate = tonumber(r) or 0 end
            end
            if rate <= 0 then
                local scale = tonumber(item.Scale or item.AssetScale) or 1
                local mutMult = 1
                if type(item.Mutations) == "table" then
                    for _, m in pairs(item.Mutations) do
                        local mVal = (type(m) == "table" and (m.Multiplier or m.Value)) or tonumber(m)
                        mutMult = mutMult * (tonumber(mVal) or 1.5)
                    end
                end
                rate = 100 * scale * mutMult
            end

            local price = rate * 100
            if PriceOf and type(PriceOf) == "function" then
                local okp, p = pcall(PriceOf, item)
                if okp and tonumber(p) then price = tonumber(p) end
            end
            if price <= 0 then price = 50000 + rate * 10 end

            local rarity = tostring(item.Rarity or "Common")

            list[#list + 1] = {
                uid      = uid,
                cat      = cat,
                rarity   = rarity,
                rate     = rate,
                price    = price,
                favorite = item.IsFavorite == true or item.Favorite == true,
                inFuse   = item.InFuse == true,
                equipped = equipped[uid] == true,
            }
        end
    end
    petCache, petCacheAt = list, now
    return list
end

