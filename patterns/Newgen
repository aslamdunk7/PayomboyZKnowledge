    -- Curtain is open: check transition from closed to open
    if _lastCurtainState then
        _lastCurtainState = false
        _curtainOpenedAt = now -- Just opened!
    end
    -- Must wait 3 seconds after curtain opens before dashing
    if (now - _curtainOpenedAt) < 3.0 then
        return false, "Curtain opening cooldown (3s)"
