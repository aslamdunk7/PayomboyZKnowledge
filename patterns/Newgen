local function sellPetPlan(yieldEvery)
    local list = petItems(false, yieldEvery)
    if #list == 0 then return {} end

    local keep = {}
    for i = 1, math.min(Cfg.SellKeepTop or 0, #list) do keep[list[i].uid] = true end

    local hasRaritySelected = false
    if Cfg.SellPetRarities and type(Cfg.SellPetRarities) == "table" then
        for _, v in pairs(Cfg.SellPetRarities) do
            if v == true then hasRaritySelected = true break end
        end
    end

    local candidates = {}
    for _, p in ipairs(list) do
        local isBillionTier = (p.rate and p.rate >= 1e9) or (p.price and p.price >= 1e9)
        if not (p.equipped or p.favorite or p.inFuse or keep[p.uid] or isBillionTier) then
            if hasRaritySelected then
                local limit    = tonumber(Cfg.SellPetBelow) or 0
                local byPrice  = limit > 0 and p.price < limit
                local byRarity = Cfg.SellPetRarities[p.rarity] == true

                local take
                if Cfg.SellPetMode == "ระดับที่เลือก" then take = byRarity
                elseif Cfg.SellPetMode == "ทั้งสองเงื่อนไข" then take = byRarity and byPrice
                else take = byPrice end

                if take then candidates[#candidates + 1] = p end
            else
                candidates[#candidates + 1] = p
            end
        end
    end

    table.sort(candidates, function(a, b) return a.price < b.price end)

    if hasRaritySelected then
        return candidates
    else
        local totalCapacity = 200
        local maxAllowedPets = math.floor(totalCapacity * 0.60)
        local excess = #list - maxAllowedPets
        if excess <= 0 then return {} end

        local plan = {}
        for i = 1, math.min(excess, #candidates) do plan[#plan + 1] = candidates[i] end
        return plan
    end
end

