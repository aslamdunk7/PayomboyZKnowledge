-- (Nav and modules initialized early above)

function Nav.curtainClosed()
    -- Method 1: AreaEggResetWall module
    if _WallModule and type(_WallModule.IsSealed) == "function" then
        local ok, sealed = pcall(_WallModule.IsSealed)
        if ok and sealed ~= nil then return sealed == true end
    end
    -- Method 2: AreaEggCycle module
    if _CycleModule and type(_CycleModule.IsNightPhase) == "function" then
        local ok, night = pcall(_CycleModule.IsNightPhase, os.time())
        if ok and night ~= nil then return night == true end
    end
    -- Method 3: WallStartCollision in __OBJECTS
    local objs = Workspace:FindFirstChild("__OBJECTS")
    local areas = objs and objs:FindFirstChild("Areas")
    local wall = areas and areas:FindFirstChild("WallStartCollision")
    if wall and wall:IsA("BasePart") then
        return wall.CanCollide == true or wall.Transparency < 0.9
    end
    -- Method 4: Lighting-based day/night check
    local clock = Lighting and Lighting.ClockTime or 12
    if clock < 6 or clock > 18 then return true end
    return false
end

function Nav.secondsUntilDawn()
    if _CycleModule and type(_CycleModule.SecondsUntilReset) == "function" then
        local ok, sec = pcall(_CycleModule.SecondsUntilReset, os.time())
        if ok and tonumber(sec) then return tonumber(sec) end
    end
    local clock = Lighting and Lighting.ClockTime or 12
    if clock >= 6 and clock <= 18 then return 999 end
    local remainingHours = (clock < 6) and (6 - clock) or (24 - clock + 6)
    return remainingHours * 4
end

function Nav.onTreadmill()
    local c = E and E.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    return hum and hum.SeatPart ~= nil
end

function Nav.leaveTreadmill()
    leaveTreadmill()
end

