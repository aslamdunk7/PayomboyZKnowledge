                            end
                            distLbl.Text = string.format("%dm • %s%s", dist, rar, priceStr)
                            distLbl.TextColor3 = Color3.fromRGB(220, 220, 230)
                            distLbl.Font = Enum.Font.Gotham
                            distLbl.TextSize = 9
                            distLbl.Parent = bg

                            espTags[uid] = {
                                gui = bb,
                                refPart = adorneePart,
                                distLbl = distLbl,
                                rec = rec,
                                rar = rar
                            }
                        else
                            if tagData.distLbl then
                                local priceStr = ""
                                if tagData.rec and tagData.rec._SellPrice and tagData.rec._SellPrice > 0 then
                                    priceStr = " • $" .. tostring(tagData.rec._SellPrice)
                                end
                                tagData.distLbl.Text = string.format("%dm • %s%s", dist, tagData.rar or "", priceStr)
                            end
                        end
                    end
                end
            end
        end
    end

    for uid, tagData in pairs(espTags) do
        if not liveUids[uid] then
            pcall(function()
                if tagData.gui then tagData.gui:Destroy() end
                if tagData.refPart then tagData.refPart:Destroy() end
            end)
            espTags[uid] = nil
        end
    end
end


