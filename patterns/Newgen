-- 🛡️ Safe GUI Parent Resolver (Prevents CoreGui crash on mobile/lower executors)
local function getSafeGuiParent()
    local parent = nil
    pcall(function()
        if typeof(gethui) == "function" then
            parent = gethui()
        end
    end)
    if not parent then
        pcall(function()
            if syn and syn.protect_gui then
                parent = CoreGui
            end
        end)
    end
    if not parent then
        pcall(function()
            parent = LocalPlayer:FindFirstChild("PlayerGui")
        end)
    end
    if not parent then
        parent = CoreGui
    end
    return parent
end

